# Not used by the current site — this is a plain static HTML/CSS/JS project with no build
# step, so nothing here is actually loaded at runtime. The real Supabase config lives in
# js/supabase-config.js and is intentionally public (see README/commit notes on why the
# anon key is safe to commit: Row Level Security in supabase/schema.sql is what actually
# gates access, not secrecy of that key).
#
# This file is only a reference for when this project becomes the full Next.js + Supabase
# setup. Copy it to .env.local there and fill in real values — .env.local is already
# covered by .gitignore so it won't get committed.
#
# NEXT_PUBLIC_* vars end up in the browser bundle — fine, same trust level as the anon key
# already committed today. Anything without that prefix is server-only and must never be
# committed with a real value.

NEXT_PUBLIC_SUPABASE_URL=https://pftgmhzdfegsckvuasox.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Do NOT add NEXT_PUBLIC_ to this one, and do NOT commit a real value —
# it bypasses Row Level Security entirely. Only use it in trusted server code (API routes,
# server actions), never send it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
